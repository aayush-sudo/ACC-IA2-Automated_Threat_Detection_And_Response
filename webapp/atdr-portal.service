[Unit]
Description=ATDR Demo Portal (Flask on gunicorn, port 80)
After=network-online.target
Wants=network-online.target

[Service]
User=atdr
Group=atdr
WorkingDirectory=/opt/atdr
# The app writes one JSON access-log line per request to stdout -> journald.
# gunicorn's own access log is off so nothing (e.g. query strings) is double-logged.
ExecStart=/usr/bin/gunicorn --workers 2 --bind 0.0.0.0:80 --error-logfile - app:app
Restart=always
RestartSec=2
# Bind to port 80 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
