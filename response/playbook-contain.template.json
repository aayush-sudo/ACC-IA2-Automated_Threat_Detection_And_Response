{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "ATDR containment playbook (Person 3). Sentinel incident trigger -> validate -> Medium: notify; High: record NSG, snapshot OS disk, isolate NIC, quarantine tags, verify, comment, notify. Contains no secrets: the Discord webhook URL is a securestring deployment parameter."
  },
  "parameters": {
    "location": { "type": "string", "defaultValue": "[resourceGroup().location]" },
    "workflowName": { "type": "string", "defaultValue": "atdr-playbook-contain" },
    "connectionName": { "type": "string", "defaultValue": "atdr-conn-sentinel" },
    "protectedVmId": { "type": "string", "metadata": { "description": "ARM ID of the only VM this playbook may act on." } },
    "isolationNsgId": { "type": "string", "metadata": { "description": "ARM ID of atdr-nsg-isolation." } },
    "notifyTo": { "type": "securestring", "metadata": { "description": "Discord incoming-webhook URL. Never commit it." } }
  },
  "variables": {
    "sentinelApiId": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', parameters('location'), 'azuresentinel')]",
    "tags": { "Project": "ATDR", "Role": "ResponsePlaybook" }
  },
  "resources": [
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[parameters('connectionName')]",
      "location": "[parameters('location')]",
      "kind": "V1",
      "tags": "[variables('tags')]",
      "properties": {
        "displayName": "[parameters('connectionName')]",
        "customParameterValues": {},
        "parameterValueType": "Alternative",
        "api": { "id": "[variables('sentinelApiId')]" }
      }
    },
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2019-05-01",
      "name": "[parameters('workflowName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "identity": { "type": "SystemAssigned" },
      "dependsOn": [
        "[resourceId('Microsoft.Web/connections', parameters('connectionName'))]"
      ],
      "properties": {
        "state": "Enabled",
        "parameters": {
          "$connections": {
            "value": {
              "azuresentinel": {
                "connectionId": "[resourceId('Microsoft.Web/connections', parameters('connectionName'))]",
                "connectionName": "[parameters('connectionName')]",
                "id": "[variables('sentinelApiId')]",
                "connectionProperties": { "authentication": { "type": "ManagedServiceIdentity" } }
              }
            }
          },
          "protectedVmId": { "value": "[parameters('protectedVmId')]" },
          "isolationNsgId": { "value": "[parameters('isolationNsgId')]" },
          "notifyTo": { "value": "[parameters('notifyTo')]" }
        },
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "$connections": { "type": "Object", "defaultValue": {} },
            "protectedVmId": { "type": "String" },
            "isolationNsgId": { "type": "String" },
            "notifyTo": { "type": "SecureString" }
          },
          "triggers": {
            "Microsoft_Sentinel_incident": {
              "type": "ApiConnectionWebhook",
              "inputs": {
                "host": { "connection": { "name": "@parameters('$connections')['azuresentinel']['connectionId']" } },
                "body": { "callback_url": "@{listCallbackUrl()}" },
                "path": "/incident-creation"
              }
            }
          },
          "actions": {
            "Incident": {
              "type": "Compose",
              "runAfter": {},
              "inputs": {
                "number": "@triggerBody()?['object']?['properties']?['incidentNumber']",
                "title": "@triggerBody()?['object']?['properties']?['title']",
                "severity": "@triggerBody()?['object']?['properties']?['severity']",
                "createdTimeUtc": "@triggerBody()?['object']?['properties']?['createdTimeUtc']",
                "armId": "@triggerBody()?['object']?['id']",
                "url": "@triggerBody()?['object']?['properties']?['incidentUrl']",
                "playbookStartUtc": "@{trigger()?['startTime']}",
                "runId": "@{workflow()?['run']?['name']}"
              }
            },
            "Filter_IP_entities": {
              "type": "Query",
              "runAfter": { "Incident": [ "Succeeded" ] },
              "inputs": {
                "from": "@coalesce(triggerBody()?['object']?['properties']?['relatedEntities'], json('[]'))",
                "where": "@equals(toLower(coalesce(item()?['kind'], '')), 'ip')"
              }
            },
            "Client_IP": {
              "type": "Compose",
              "runAfter": { "Filter_IP_entities": [ "Succeeded" ] },
              "inputs": "@if(empty(body('Filter_IP_entities')), 'not present in incident', coalesce(first(body('Filter_IP_entities'))?['properties']?['address'], 'not present in incident'))"
            },
            "Get_VM": {
              "type": "Http",
              "runAfter": { "Client_IP": [ "Succeeded" ] },
              "inputs": {
                "method": "GET",
                "uri": "https://management.azure.com@{parameters('protectedVmId')}?api-version=2024-07-01",
                "authentication": { "type": "ManagedServiceIdentity", "audience": "https://management.azure.com/" }
              }
            },
            "Validate": {
              "type": "Compose",
              "runAfter": { "Get_VM": [ "Succeeded", "Failed" ] },
              "inputs": {
                "severity": "@outputs('Incident')?['severity']",
                "severityAllowed": "@contains(createArray('High', 'Medium'), outputs('Incident')?['severity'])",
                "vmHttpStatus": "@outputs('Get_VM')?['statusCode']",
                "tagProject": "@coalesce(body('Get_VM')?['tags']?['Project'], '(missing)')",
                "tagRole": "@coalesce(body('Get_VM')?['tags']?['Role'], '(missing)')"
              }
            },
            "Is_valid": {
              "type": "If",
              "runAfter": { "Validate": [ "Succeeded" ] },
              "expression": {
                "and": [
                  { "equals": [ "@outputs('Validate')?['severityAllowed']", true ] },
                  { "equals": [ "@outputs('Validate')?['vmHttpStatus']", 200 ] },
                  { "equals": [ "@outputs('Validate')?['tagProject']", "ATDR" ] },
                  { "equals": [ "@outputs('Validate')?['tagRole']", "TestBackend" ] }
                ]
              },
              "actions": {},
              "else": {
                "actions": {
                  "Comment_rejected": {
                    "type": "Http",
                    "runAfter": {},
                    "inputs": {
                      "method": "PUT",
                      "uri": "https://management.azure.com@{outputs('Incident')?['armId']}/comments/@{guid()}?api-version=2024-03-01",
                      "authentication": { "type": "ManagedServiceIdentity", "audience": "https://management.azure.com/" },
                      "body": {
                        "properties": {
                          "message": "<b>ATDR playbook atdr-playbook-contain: REJECTED, no action taken.</b><br>Severity: @{outputs('Validate')?['severity']} (allowed: Medium, High)<br>Protected VM lookup: HTTP @{outputs('Validate')?['vmHttpStatus']}<br>VM tags: Project=@{outputs('Validate')?['tagProject']}, Role=@{outputs('Validate')?['tagRole']} (required: Project=ATDR, Role=TestBackend)<br>Run: @{outputs('Incident')?['runId']}"
                        }
                      }
                    }
                  },
                  "Terminate_rejected": {
                    "type": "Terminate",
                    "runAfter": { "Comment_rejected": [ "Succeeded", "Failed" ] },
                    "inputs": {
                      "runStatus": "Failed",
                      "runError": {
                        "code": "Rejected",
                        "message": "Validation failed: severity=@{outputs('Validate')?['severity']}, vmHttpStatus=@{outputs('Validate')?['vmHttpStatus']}, Project=@{outputs('Validate')?['tagProject']}, Role=@{outputs('Validate')?['tagRole']}"
                      }
                    }
                  }
                }
              }
            },
            "Is_high": {
              "type": "If",
              "runAfter": { "Is_valid": [ "Succeeded" ] },
              "expression": { "and": [ { "equals": [ "@outputs('Incident')?['severity']", "High" ] } ] },
              "actions": {
                "Containment": {
                  "type": "Scope",
                  "runAfter": {},
                  "actions": {
                    "Get_NIC": {
                      "type": "Http",
                      "runAfter": {},
                      "inputs": {
                        "method": "GET",
                        "uri": "https://management.azure.com@{body('Get_VM')?['properties']?['networkProfile']?['networkInterfaces']?[0]?['id']}?api-version=2024-05-01",
                        "authentication": { "type": "ManagedServiceIdentity", "audience": "https://management.azure.com/" }
                      }
                    },
                    "Original_NSG": {
                      "type": "Compose",
                      "runAfter": { "Get_NIC": [ "Succeeded" ] },
                      "inputs": "@coalesce(body('Get_NIC')?['properties']?['networkSecurityGroup']?['id'], 'none')"
                    },
                    "Already_isolated": {
                      "type": "Compose",
                      "runAfter": { "Original_NSG": [ "Succeeded" ] },
                      "inputs": "@equals(toLower(outputs('Original_NSG')), toLower(parameters('isolationNsgId')))"
                    },
                    "Tags_with_OriginalNsg": {
                      "type": "Compose",
                      "runAfter": { "Already_isolated": [ "Succeeded" ] },
                      "inputs": "@setProperty(coalesce(body('Get_VM')?['tags'], json('{}')), 'OriginalNsg', if(outputs('Already_isolated'), coalesce(body('Get_VM')?['tags']?['OriginalNsg'], 'unknown'), outputs('Original_NSG')))"
                    },
                    "a_Tag_OriginalNsg": {
                      "type": "Http",
                      "runAfter": { "Tags_with_OriginalNsg": [ "Succeeded" ] },
                      "inputs": {
                        "method": "PATCH",
                        "uri": "https://management.azure.com@{parameters('protectedVmId')}?api-version=2024-07-01",
                        "authentication": { "type": "ManagedServiceIdentity", "audience": "https://management.azure.com/" },
                        "body": { "tags": "@outputs('Tags_with_OriginalNsg')" }
                      }
                    },
                    "Resource_group_id": {
                      "type": "Compose",
                      "runAfter": { "a_Tag_OriginalNsg": [ "Succeeded" ] },
                      "inputs": "@first(split(parameters('protectedVmId'), '/providers/'))"
                    },
                    "b_Snapshot_OS_disk": {
                      "type": "Http",
                      "runAfter": { "Resource_group_id": [ "Succeeded" ] },
                      "inputs": {
                        "method": "PUT",
                        "uri": "https://management.azure.com@{outputs('Resource_group_id')}/providers/Microsoft.Compute/snapshots/atdr-snap-@{outputs('Incident')?['number']}?api-version=2024-03-02",
                        "authentication": { "type": "ManagedServiceIdentity", "audience": "https://management.azure.com/" },
                        "body": {
                          "location": "@body('Get_VM')?['location']",
                          "sku": { "name": "Standard_LRS" },
                          "tags": { "Project": "ATDR", "Purpose": "Forensics", "IncidentNumber": "@{outputs('Incident')?['number']}" },
                          "properties": {
                            "creationData": {
                              "createOption": "Copy",
                              "sourceResourceId": "@body('Get_VM')?['properties']?['storageProfile']?['osDisk']?['managedDisk']?['id']"
                            },
                            "incremental": true
                          }
                        }
                      }
                    },
                    "Isolation_NSG_ref": {
                      "type": "Compose",
                      "runAfter": { "b_Snapshot_OS_disk": [ "Succeeded" ] },
                      "inputs": { "id": "@parameters('isolationNsgId')" }
                    },
                    "c_Isolate_NIC": {
                      "type": "Http",
                      "runAfter": { "Isolation_NSG_ref": [ "Succeeded" ] },
                      "inputs": {
                        "method": "PUT",
                        "uri": "https://management.azure.com@{body('Get_NIC')?['id']}?api-version=2024-05-01",
                        "authentication": { "type": "ManagedServiceIdentity", "audience": "https://management.azure.com/" },
                        "body": "@setProperty(body('Get_NIC'), 'properties', setProperty(body('Get_NIC')?['properties'], 'networkSecurityGroup', outputs('Isolation_NSG_ref')))"
                      }
                    },
                    "Quarantine_tags": {
                      "type": "Compose",
                      "runAfter": { "c_Isolate_NIC": [ "Succeeded" ] },
                      "inputs": "@union(outputs('Tags_with_OriginalNsg'), json(concat('{\"SecurityStatus\":\"Quarantined\",\"IncidentNumber\":\"', string(outputs('Incident')?['number']), '\",\"QuarantinedAt\":\"', utcNow(), '\"}')))"
                    },
                    "d_Tag_quarantine": {
                      "type": "Http",
                      "runAfter": { "Quarantine_tags": [ "Succeeded" ] },
                      "inputs": {
                        "method": "PATCH",
                        "uri": "https://management.azure.com@{parameters('protectedVmId')}?api-version=2024-07-01",
                        "authentication": { "type": "ManagedServiceIdentity", "audience": "https://management.azure.com/" },
                        "body": { "tags": "@outputs('Quarantine_tags')" }
                      }
                    },
                    "e_Verify_NIC": {
                      "type": "Http",
                      "runAfter": { "d_Tag_quarantine": [ "Succeeded" ] },
                      "inputs": {
                        "method": "GET",
                        "uri": "https://management.azure.com@{body('Get_NIC')?['id']}?api-version=2024-05-01",
                        "authentication": { "type": "ManagedServiceIdentity", "audience": "https://management.azure.com/" }
                      }
                    },
                    "e_Verify_snapshot": {
                      "type": "Http",
                      "runAfter": { "e_Verify_NIC": [ "Succeeded" ] },
                      "inputs": {
                        "method": "GET",
                        "uri": "https://management.azure.com@{outputs('Resource_group_id')}/providers/Microsoft.Compute/snapshots/atdr-snap-@{outputs('Incident')?['number']}?api-version=2024-03-02",
                        "authentication": { "type": "ManagedServiceIdentity", "audience": "https://management.azure.com/" }
                      }
                    },
                    "Verification": {
                      "type": "Compose",
                      "runAfter": { "e_Verify_snapshot": [ "Succeeded" ] },
                      "inputs": {
                        "nicNsgId": "@body('e_Verify_NIC')?['properties']?['networkSecurityGroup']?['id']",
                        "nicIsolated": "@equals(toLower(coalesce(body('e_Verify_NIC')?['properties']?['networkSecurityGroup']?['id'], '')), toLower(parameters('isolationNsgId')))",
                        "snapshotName": "@body('e_Verify_snapshot')?['name']",
                        "snapshotState": "@body('e_Verify_snapshot')?['properties']?['provisioningState']",
                        "snapshotSucceeded": "@equals(body('e_Verify_snapshot')?['properties']?['provisioningState'], 'Succeeded')",
                        "alreadyIsolatedBefore": "@outputs('Already_isolated')",
                        "originalNsgRecorded": "@outputs('Tags_with_OriginalNsg')?['OriginalNsg']",
                        "isolationVerifiedUtc": "@utcNow()"
                      }
                    }
                  }
                },
                "Containment_steps": {
                  "type": "Select",
                  "runAfter": { "Containment": [ "Succeeded", "Failed", "Skipped", "TimedOut" ] },
                  "inputs": {
                    "from": "@result('Containment')",
                    "select": "@concat(item()?['name'], ': ', item()?['status'], ' at ', coalesce(item()?['endTime'], '-'), if(empty(item()?['error']), '', concat(' (', coalesce(item()?['error']?['code'], ''), ')')))"
                  }
                },
                "Filter_verification": {
                  "type": "Query",
                  "runAfter": { "Containment_steps": [ "Succeeded" ] },
                  "inputs": {
                    "from": "@result('Containment')",
                    "where": "@and(equals(item()?['name'], 'Verification'), equals(item()?['status'], 'Succeeded'))"
                  }
                },
                "Verification_result": {
                  "type": "Compose",
                  "runAfter": { "Filter_verification": [ "Succeeded" ] },
                  "inputs": "@if(empty(body('Filter_verification')), json('{\"nicIsolated\":false,\"snapshotSucceeded\":false,\"snapshotState\":\"not verified\",\"isolationVerifiedUtc\":\"-\"}'), first(body('Filter_verification'))?['outputs'])"
                },
                "Comment_high": {
                  "type": "Http",
                  "runAfter": { "Verification_result": [ "Succeeded" ] },
                  "inputs": {
                    "method": "PUT",
                    "uri": "https://management.azure.com@{outputs('Incident')?['armId']}/comments/@{guid()}?api-version=2024-03-01",
                    "authentication": { "type": "ManagedServiceIdentity", "audience": "https://management.azure.com/" },
                    "body": {
                      "properties": {
                        "message": "<b>ATDR playbook atdr-playbook-contain: HIGH severity containment</b><br>Incident #@{outputs('Incident')?['number']}: @{outputs('Incident')?['title']}<br>Client IP: @{outputs('Client_IP')}<br>Protected VM: @{body('Get_VM')?['name']} (from playbook parameter, not from the alert)<br>Containment scope result: @{actions('Containment')?['status']}<br>Steps:<br>@{join(body('Containment_steps'), '<br>')}<br>Verification: NIC isolated = @{outputs('Verification_result')?['nicIsolated']}; snapshot atdr-snap-@{outputs('Incident')?['number']} state = @{outputs('Verification_result')?['snapshotState']}; verified at @{outputs('Verification_result')?['isolationVerifiedUtc']}<br>Rollback: response/rollback.sh (re-attaches the NSG stored in VM tag OriginalNsg)<br>Run: @{outputs('Incident')?['runId']}"
                      }
                    }
                  }
                },
                "Notification_high": {
                  "type": "Compose",
                  "runAfter": { "Comment_high": [ "Succeeded", "Failed" ] },
                  "inputs": "@concat('**ATDR containment: incident #', string(outputs('Incident')?['number']), ' (', outputs('Incident')?['severity'], ')**\n', 'Title: ', outputs('Incident')?['title'], '\n', 'Client IP: ', outputs('Client_IP'), '\n', 'VM: ', body('Get_VM')?['name'], '\n', 'Incident created: ', string(outputs('Incident')?['createdTimeUtc']), '\n', 'Playbook started: ', outputs('Incident')?['playbookStartUtc'], '\n', 'Containment: ', actions('Containment')?['status'], '\n', join(body('Containment_steps'), '\n'), '\n', 'NIC isolated: ', string(outputs('Verification_result')?['nicIsolated']), ' | snapshot: ', string(outputs('Verification_result')?['snapshotState']), ' | verified at ', string(outputs('Verification_result')?['isolationVerifiedUtc']), '\n', 'Incident comment: ', actions('Comment_high')?['status'], '\n', 'Run: ', outputs('Incident')?['runId'])"
                },
                "g_Notify_high": {
                  "type": "Http",
                  "runAfter": { "Notification_high": [ "Succeeded" ] },
                  "runtimeConfiguration": { "secureData": { "properties": [ "inputs" ] } },
                  "inputs": {
                    "method": "POST",
                    "uri": "@parameters('notifyTo')",
                    "headers": { "Content-Type": "application/json" },
                    "body": { "username": "ATDR Playbook", "content": "@{substring(outputs('Notification_high'), 0, min(length(outputs('Notification_high')), 1900))}" }
                  }
                },
                "Containment_complete": {
                  "type": "If",
                  "runAfter": { "g_Notify_high": [ "Succeeded", "Failed" ] },
                  "expression": {
                    "and": [
                      { "equals": [ "@actions('Containment')?['status']", "Succeeded" ] },
                      { "equals": [ "@outputs('Verification_result')?['nicIsolated']", true ] },
                      { "equals": [ "@outputs('Verification_result')?['snapshotSucceeded']", true ] }
                    ]
                  },
                  "actions": {},
                  "else": {
                    "actions": {
                      "Terminate_incomplete": {
                        "type": "Terminate",
                        "runAfter": {},
                        "inputs": {
                          "runStatus": "Failed",
                          "runError": { "code": "ContainmentIncomplete", "message": "Containment=@{actions('Containment')?['status']}, nicIsolated=@{outputs('Verification_result')?['nicIsolated']}, snapshot=@{outputs('Verification_result')?['snapshotState']}" }
                        }
                      }
                    }
                  }
                }
              },
              "else": {
                "actions": {
                  "Comment_medium": {
                    "type": "Http",
                    "runAfter": {},
                    "inputs": {
                      "method": "PUT",
                      "uri": "https://management.azure.com@{outputs('Incident')?['armId']}/comments/@{guid()}?api-version=2024-03-01",
                      "authentication": { "type": "ManagedServiceIdentity", "audience": "https://management.azure.com/" },
                      "body": {
                        "properties": {
                          "message": "<b>ATDR playbook atdr-playbook-contain: MEDIUM severity, notify only</b><br>Incident #@{outputs('Incident')?['number']}: @{outputs('Incident')?['title']}<br>Client IP: @{outputs('Client_IP')}<br>No containment performed (policy: only High severity isolates the backend). Team notified.<br>Run: @{outputs('Incident')?['runId']}"
                        }
                      }
                    }
                  },
                  "Notification_medium": {
                    "type": "Compose",
                    "runAfter": { "Comment_medium": [ "Succeeded", "Failed" ] },
                    "inputs": "@concat('**ATDR alert: incident #', string(outputs('Incident')?['number']), ' (', outputs('Incident')?['severity'], ', notify only)**\n', 'Title: ', outputs('Incident')?['title'], '\n', 'Client IP: ', outputs('Client_IP'), '\n', 'VM: ', body('Get_VM')?['name'], ' (no action taken)\n', 'Incident created: ', string(outputs('Incident')?['createdTimeUtc']), '\n', 'Playbook started: ', outputs('Incident')?['playbookStartUtc'], '\n', 'Incident comment: ', actions('Comment_medium')?['status'], '\n', 'Run: ', outputs('Incident')?['runId'])"
                  },
                  "g_Notify_medium": {
                    "type": "Http",
                    "runAfter": { "Notification_medium": [ "Succeeded" ] },
                    "runtimeConfiguration": { "secureData": { "properties": [ "inputs" ] } },
                    "inputs": {
                      "method": "POST",
                      "uri": "@parameters('notifyTo')",
                      "headers": { "Content-Type": "application/json" },
                      "body": { "username": "ATDR Playbook", "content": "@{outputs('Notification_medium')}" }
                    }
                  }
                }
              }
            }
          },
          "outputs": {}
        }
      }
    }
  ],
  "outputs": {
    "principalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Logic/workflows', parameters('workflowName')), '2019-05-01', 'full').identity.principalId]"
    }
  }
}
